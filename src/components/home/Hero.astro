---
import { getConfig } from '@lib/config';
import { Content as AboutContent } from '../../content/about.md';

const config = getConfig();
const nameParts = config.profile.name.trim().split(/\s+/);
const surname = nameParts.length > 1 ? nameParts.pop() : '';
const givenNames = nameParts.join(' ');

const avatars = config.theme?.avatars?.filter((a: string) => a && a.length > 0) || [];
const avatarSrc = avatars.length > 0 ? avatars[Math.floor(Math.random() * avatars.length)] : config.profile.avatar;

// Social link icons (inline SVG paths)
const socialIcons: Record<string, { viewBox: string; path: string }> = {
  google_scholar: { viewBox: '0 0 24 24', path: 'M12 24a7 7 0 110-14 7 7 0 010 14zm0-24L0 9.5l4.838 3.94A8 8 0 0112 9a8 8 0 018 8 8 8 0 01-1.838 5.09L24 9.5z' },
  github: { viewBox: '0 0 24 24', path: 'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z' },
  twitter: { viewBox: '0 0 24 24', path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
  linkedin: { viewBox: '0 0 24 24', path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z' },
  orcid: { viewBox: '0 0 24 24', path: 'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378a.875.875 0 110 1.75.875.875 0 010-1.75zm-.78 3.451h1.56v11.2h-1.56zm3.921 0h4.212c4.363 0 6.47 2.858 6.47 5.6 0 2.742-2.107 5.6-6.47 5.6h-4.212zm1.56 1.38v8.44h2.652c3.584 0 4.91-2.37 4.91-4.22 0-1.85-1.326-4.22-4.91-4.22z' },
  email: { viewBox: '0 0 20 16', path: 'M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884zM18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z' },
};

const activeSocials = Object.entries(config.social).filter(([_, url]) => url && url.length > 0);
---

<section class="animate-on-scroll">
  <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-5 gap-y-6 md:gap-x-12 md:gap-y-0 items-start">
    <!-- Profile photo -->
    <div class="col-start-1 row-start-1 md:row-span-2">
      <div class="avatar-frame">
        <img
          src={avatarSrc}
          alt={config.profile.name}
          class="w-30 h-40 sm:w-36 sm:h-48 md:w-48 md:h-64 rounded-lg object-cover object-center shadow-lg"
          data-avatar-img
          onerror="this.style.display='none'"
        />
      </div>
    </div>

    <div class="col-start-2 row-start-1 min-w-0 self-center md:self-start">
      <h1 class="hero-name" aria-label={config.profile.name}>
        <span class="hero-given-names">{givenNames}</span>
        {surname && <em class="hero-surname">{surname}</em>}
      </h1>
      <p class="mt-3 text-sm leading-snug text-[var(--color-text-secondary)] sm:text-base md:text-lg md:leading-normal">
        {config.profile.position}{config.profile.affiliation && `, ${config.profile.affiliation}`}
      </p>
      <p class="text-sm leading-snug text-[var(--color-text-secondary)] sm:text-base md:text-lg md:leading-normal">{config.profile.university}</p>
    </div>

    <!-- Profile info -->
    <div class="col-span-2 row-start-2 min-w-0 md:col-span-1 md:col-start-2">
      <!-- Social links -->
      <div class="mt-4 flex flex-wrap gap-2">
        {activeSocials.map(([key, url]) => (
          <a
            href={key === 'email' ? `mailto:${url}` : url}
            target={key === 'email' ? undefined : '_blank'}
            rel={key === 'email' ? undefined : 'noopener noreferrer'}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] hover:bg-[var(--color-accent)]/10 transition-colors"
            aria-label={key.replace('_', ' ')}
          >
            <svg class="w-4 h-4" viewBox={socialIcons[key]?.viewBox || '0 0 24 24'} fill="currentColor">
              <path d={socialIcons[key]?.path || socialIcons.email.path} />
            </svg>
            <span class="capitalize">{key.replace('_', ' ')}</span>
          </a>
        ))}
      </div>

      <!-- Bio -->
      <div class="prose mt-6 max-w-2xl"><AboutContent /></div>
    </div>
  </div>
</section>

<style>
  .hero-name {
    font-family: 'EB Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 14vw, 3.0rem);
    text-transform: capitalize;
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.035em;
    color: var(--color-text);
  }

  .hero-given-names,
  .hero-surname {
    display: block;
  }

  .hero-surname {
    font-weight: 600;
    color: var(--color-accent);
    text-transform: capitalize;
  }

  @media (max-width: 359px) {
    .hero-name {
      font-size: 2.5rem;
    }
  }

  @media (min-width: 768px) {
    .hero-name {
      font-size: clamp(3rem, 7vw, 4rem);
    }
  }
</style>

<script define:vars={{ avatars }}>
document.addEventListener('astro:page-load', () => {
  if (avatars.length > 1) {
    const img = document.querySelector('[data-avatar-img]');
    if (img) {
      const pick = avatars[Math.floor(Math.random() * avatars.length)];
      img.setAttribute('src', pick);
    }
  }
});
</script>
