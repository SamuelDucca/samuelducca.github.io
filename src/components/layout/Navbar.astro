---
import { getConfig, getEnabledPages } from '@lib/config';
import ThemePicker from '../ui/ThemePicker.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

const config = getConfig();
const showThemePicker = config.theme.show_theme_picker ?? true;
const showModeToggle = config.theme.show_mode_toggle ?? true;
const pages = getEnabledPages();
const currentPath = Astro.url.pathname;

const MAX_VISIBLE = 7;
const visiblePages = pages.slice(0, MAX_VISIBLE);
const mobilePrimaryPages = pages.slice(0, 3);
const isMobileMoreActive = pages.slice(3).some(p => currentPath === p.path || (p.path !== '/' && currentPath.startsWith(p.path)));
const overflowPages = pages.slice(MAX_VISIBLE);
const isOverflowActive = overflowPages.some(p => currentPath === p.path || (p.path !== '/' && currentPath.startsWith(p.path)));
---

<nav class="glass sticky top-0 z-50 border-b border-[var(--color-glass-border)]" transition:animate="none">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 md:h-16">
      <!-- Site title / logo -->
      <a href="/" class="site-title text-lg font-semibold text-[var(--color-text)] hover:text-[var(--color-accent)] transition-colors shrink-0">
        {config.site.title}
      </a>

      <!-- Desktop nav links -->
      <div class="hidden md:flex items-center gap-0.5">
        {visiblePages.map(page => (
          <a
            href={page.path}
            class:list={[
              'px-2.5 py-1.5 rounded-lg text-sm font-medium transition-colors whitespace-nowrap',
              currentPath === page.path || (page.path !== '/' && currentPath.startsWith(page.path))
                ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/10 nav-link-active'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/50'
            ]}
          >
            {page.label}
          </a>
        ))}

        {overflowPages.length > 0 && (
          <div class="relative" id="more-dropdown">
            <button
              id="more-btn"
              class:list={[
                'px-2.5 py-1.5 rounded-lg text-sm font-medium transition-colors whitespace-nowrap inline-flex items-center gap-1',
                isOverflowActive
                  ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/10'
                  : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/50'
              ]}
              aria-expanded="false"
              aria-controls="more-menu"
            >
              More
              <svg class="w-3.5 h-3.5 transition-transform" id="more-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div
              id="more-menu"
              class="hidden absolute right-0 top-full mt-1 py-1 min-w-[160px] rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-lg z-50"
            >
              {overflowPages.map(page => (
                <a
                  href={page.path}
                  class:list={[
                    'block px-4 py-2 text-sm transition-colors',
                    currentPath === page.path || (page.path !== '/' && currentPath.startsWith(page.path))
                      ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/10'
                      : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/50'
                  ]}
                >
                  {page.label}
                </a>
              ))}
            </div>
          </div>
        )}

        {(showThemePicker || showModeToggle) && (
          <div class="ml-1.5 pl-1.5 border-l border-[var(--color-border)] flex items-center gap-1 shrink-0">
            {showThemePicker && <ThemePicker />}
            {showModeToggle && <ThemeToggle />}
          </div>
        )}
      </div>

      <!-- Mobile appearance controls -->
      <div class="flex items-center gap-2 md:hidden">
        {showThemePicker && <ThemePicker />}
        {showModeToggle && <ThemeToggle />}
      </div>
    </div>

    <!-- Mobile navigation: three visible links and a menu with every page -->
    <div class="flex items-center justify-between gap-1 pb-2 md:hidden">
      {mobilePrimaryPages.map(page => (
        <a
          href={page.path}
          class:list={[
            'px-2 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors',
            currentPath === page.path || (page.path !== '/' && currentPath.startsWith(page.path))
              ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/10 nav-link-active'
              : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/50'
          ]}
        >
          {page.label}
        </a>
      ))}

      <div class="relative" id="mobile-more-dropdown">
        <button
          id="mobile-more-btn"
          type="button"
          class:list={[
            'inline-flex items-center gap-1 px-2 py-2 rounded-lg text-sm font-medium whitespace-nowrap',
            isMobileMoreActive
              ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/10'
              : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/50'
          ]}
          aria-expanded="false"
          aria-controls="mobile-more-menu"
        >
          More
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div
          id="mobile-more-menu"
          class="hidden absolute right-0 top-full mt-1 py-1 min-w-40 max-h-[70vh] overflow-y-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-card-bg)] shadow-lg z-50"
        >
          {pages.map(page => (
            <a
              href={page.path}
              class:list={[
                'block px-3 py-2 rounded-lg text-sm font-medium transition-colors',
                currentPath === page.path || (page.path !== '/' && currentPath.startsWith(page.path))
                  ? 'text-[var(--color-accent)] bg-[var(--color-accent)]/10'
                  : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-border)]/50'
              ]}
            >
              {page.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  // Delegate mobile menu clicks so the controls keep working after page transitions.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Node)) return;

    const button = document.getElementById('mobile-more-btn');
    const menu = document.getElementById('mobile-more-menu');
    const dropdown = document.getElementById('mobile-more-dropdown');
    if (!button || !menu || !dropdown) return;

    if (button.contains(target)) {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
      button.setAttribute('aria-expanded', String(!isOpen));
    } else if (!dropdown.contains(target)) {
      menu.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.getElementById('mobile-more-menu')?.classList.add('hidden');
    document.getElementById('mobile-more-btn')?.setAttribute('aria-expanded', 'false');
  });

  document.addEventListener('astro:page-load', () => {
    // "More" dropdown toggle
    const moreBtn = document.getElementById('more-btn');
    const moreMenu = document.getElementById('more-menu');
    const chevron = document.getElementById('more-chevron');
    if (moreBtn && moreMenu) {
      moreBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !moreMenu.classList.contains('hidden');
        moreMenu.classList.toggle('hidden');
        moreBtn.setAttribute('aria-expanded', String(!isOpen));
        if (chevron) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
      });

      document.addEventListener('click', (e) => {
        const dropdown = document.getElementById('more-dropdown');
        if (dropdown && !dropdown.contains(e.target as Node)) {
          moreMenu.classList.add('hidden');
          moreBtn.setAttribute('aria-expanded', 'false');
          if (chevron) chevron.style.transform = '';
        }
      });
    }
  });
</script>
